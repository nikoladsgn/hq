# Password untuk masuk ke /admin
ADMIN_PASSWORD=gantidenganpasswordkuat

# Personal Access Token GitHub (scope: repo) - dipakai admin panel untuk
# commit perubahan content.json langsung ke repo ini.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Format: username/nama-repo
GITHUB_REPO=username/nikola-pricelist

# Branch yang dipakai Vercel untuk deploy (biasanya "main")
GITHUB_BRANCH=main
